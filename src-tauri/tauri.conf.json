{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Da Capo",
  "identifier": "io.github.dacapo-editor.dacapo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Da Capo",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "The Da Capo contributors",
    "copyright": "Copyright © 2026 The Da Capo contributors. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/dacapo-editor/dacapo",
    "category": "Music",
    "shortDescription": "Open source music notation editor",
    "longDescription": "Da Capo is an open source music notation editor: write music like text, with a caret, selection, copy/paste and undo, engraved with the Bravura font and played back with the FluidR3 GM SoundFont.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["dacapo"],
        "name": "Da Capo Score",
        "description": "Da Capo score",
        "role": "Editor"
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxQTU1MjY2MzMxQUI5RTQKUldUa3VSb3pabEtsd2ZQdUdMS0s1cWpPdnN4VVQrWjFFRllsOHlnSXA0b1dydU90anFIY0lLVlQK",
      "endpoints": ["https://github.com/dacapo-editor/dacapo/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
