{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Da Capo",
  "version": "0.1.0",
  "identifier": "org.dacapo.editor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Da Capo",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["dacapo"],
        "name": "Da Capo Score",
        "description": "Da Capo score",
        "role": "Editor"
      }
    ]
  }
}
