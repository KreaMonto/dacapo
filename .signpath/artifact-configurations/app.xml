<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "app": the program itself, signed before
  it is packed into the installers. The GitHub artifact is a zip that holds
  only dacapo.exe. See docs/RELEASING.md.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="dacapo.exe" product-name="Da Capo" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
