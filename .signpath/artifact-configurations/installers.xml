<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installers": the NSIS setup and the MSI.
  The dacapo.exe inside them was already signed with the "app"
  configuration. See docs/RELEASING.md.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Da.Capo_*_x64-setup.exe" product-name="Da Capo" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <msi-file path="Da.Capo_*_x64_*.msi">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
